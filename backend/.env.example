# Database connection string for the backend PostgreSQL database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workconnect

# Port for the Go API server.
PORT=8080

# Secret used to sign and verify JWTs.
JWT_SECRET=replace-with-a-long-random-secret

# Optional CORS origin for browser requests. Falls back to http://localhost:3000 if unset.
CORS_ALLOWED_ORIGIN=http://localhost:3000
